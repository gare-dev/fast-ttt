{
    "private": true,
    "workspaces": [
        "client",
        "server"
    ],
    "scripts": {
        "dev:client": "npm --workspace client run dev",
        "dev:server": "nodemon --exec node --loader ts-node/esm server/src/http/index.ts",
        "dev:server_unit_tests": "npm --workspace server run test:unit",
        "dev:server_integration_tests": "npm --workspace server run test:integration",
        "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\""
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.6",
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^8.2.3",
        "@types/express": "^5.0.3",
        "@types/mongoose": "^5.11.97",
        "concurrently": "^8.0.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0"
    },
    "dependencies": {
        "body-parser": "^2.2.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.0",
        "express": "^5.1.0",
        "mongoose": "^8.16.4",
        "nodemon": "^3.1.10",
        "typescript": "^5.8.3",
        "uuid": "^11.1.0"
    }
}